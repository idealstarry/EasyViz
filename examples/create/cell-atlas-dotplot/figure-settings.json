{
  "width_mm": 180,
  "height_mm": 120,
  "font_family": "Arial",
  "font_size_pt": 8,
  "dpi": 300,
  "formats": [
    "pdf",
    "svg",
    "png"
  ],
  "dot_area_max_pt2": 88,
  "dot_count_scale_max": 2700,
  "color_range_percent": [
    0,
    40
  ],
  "color_stops": [
    "#BED9EA",
    "#97C3DE",
    "#71ACD2",
    "#4B96C5",
    "#2581B9"
  ],
  "group_colors": {
    "M2 macrophages": "#2581B9",
    "Other macrophages": "#DF9A3C",
    "Monocytes": "#1AA781",
    "DC": "#CC86B9"
  },
  "depot_order": [
    "sc",
    "om",
    "pvat"
  ],
  "depot_display": {
    "sc": "sc",
    "om": "om",
    "pvat": "pv"
  },
  "pooled_count_axis_max": 4000,
  "palette_family": "notch2-balanced",
  "palette_preset": "Custom 30%-to-100% tint adaptation of notch2-blue; use the explicit color_stops",
  "size_legend_color": "#2581B9",
  "palette_source": "https://www.nature.com/articles/s41467-024-53700-9",
  "palette_status": "Categorical swatches sampled from one paper figure; blue sequential ramp explicitly derived with a 30% endpoint tint to improve small borderless marks on white without changing quantitative areas or the 0-40% scale.",
  "panel_title": null,
  "caption_file": "caption.md",
  "mark_style": {
    "outline": "none",
    "edge_color": "none",
    "edge_width_pt": 0
  },
  "visual_style": {
    "text_color": "#2F3B43",
    "secondary_text_color": "#687780",
    "header_color": "#3B4952",
    "count_text_color": "#46555E",
    "header_rule_color": "#BDC7CD",
    "header_rule_width_pt": 0.45,
    "group_rule_color": "#E5EAED",
    "group_rule_width_pt": 0.3,
    "baseline_color": "#D3DCE1",
    "baseline_width_pt": 0.35,
    "annotation_strip_width": 0.75,
    "colorbar_outline": "none",
    "colorbar_tick_color": "#8B9AA4",
    "colorbar_tick_width_pt": 0.4,
    "header_font_weight": "normal"
  },
  "categorical_palette": "notch2-balanced",
  "row_pitch": 4.8,
  "legends": {
    "categorical": {
      "position": "manual",
      "anchor_mm": [
        6,
        17
      ],
      "loc": "upper left",
      "ncol": 2
    },
    "size": {
      "position": "manual",
      "anchor_mm": [
        66,
        17
      ],
      "loc": "upper left",
      "ncol": 3
    },
    "colorbar": {
      "position": "manual",
      "rect_mm": [
        128,
        11,
        32,
        1.4
      ],
      "orientation": "horizontal",
      "ticks": [
        0,
        20,
        40
      ],
      "label_position": "top"
    }
  }
}
