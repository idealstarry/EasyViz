  "assessments": [
    {
      "card": "replicate-neutral-compact",
      "status": "ready_with_notes",
      "mechanism_validity": "valid in this selected teaching task",
      "preference": "candidate",
      "evidence": "Compact graphite open means leave three raw observations and SD readable; failure broad gray fills occupy much more mass. Four narrow bar positions and 60 x 62 mm ratio suit the four short labels.",
      "limits": "Both designs remain statistically readable. Neither filled bars in general nor a neutral universal palette is disqualified; width and fill changed together."
    },
    {
      "card": "distribution-summary-lane",
      "status": "ready_with_notes",
      "mechanism_validity": "valid in this selected task",
      "preference": "candidate",
      "evidence": "Good narrow colored IQR boxes and dark whiskers/median have adjacent raw lanes. Failure points touch and compete with median/box/whisker marks. At 96 dpi the recommended side lanes remain associated by proximity to A/B/C.",
      "limits": "Side-lane placement is an adaptation, not a source statistic. Individual countability of all 66 points was not proven from the raster."
    },
    {
      "card": "violin-summary-hierarchy",
      "status": "needs_revision",
      "mechanism_validity": "partly valid; contour/summary contrast works but side-lane separation fails",
      "preference": "candidate",
      "evidence": "White body and dark fine contour are less competitive than thick colored failure contours; filled quartiles stay readable. However recommended raw dots intersect the right contour in all three groups, so the good card itself fails its layer-separation claim.",
      "limits": "Flat range-trimmed KDE ends remain a legitimate estimation choice; different visual taper is not a reason to change scientific support."
    },
    {
      "card": "heatmap-tall-narrow",
      "status": "ready_with_notes",
      "mechanism_validity": "valid in this selected task",
      "preference": "candidate",
      "evidence": "Three-column matrix is more compact, and seams distinguish pale adjacent cells; values, C1/C2/C3 and F01–F12 are legible at 96 dpi. The linear positive blue ramp and 0/50/100 legend align with the adopted quantity.",
      "limits": "Shape, seam and margin changes occur together; no universal cell aspect or automatic heatmap beauty claim follows."
    },
    {
      "card": "scatter-small-mark-color",
      "status": "ready_with_notes",
      "mechanism_validity": "valid for these marks/background",
      "preference": "candidate",
      "evidence": "Blue/pink A/B marks are readily distinguishable in actual mixed cloud and 96 dpi preview; pale failure marks have weaker white-background distinction. Legend is compact and data remains primary.",
      "limits": "Color-vision/grayscale checks not performed. Measurement1/2 labels could be spaced as Measurement 1/2, but are readable and no mapping error is visible."
    }
  ],
  "findings": [
    {
      "id": "DC-01",
      "severity": "major",
      "location": "skills/easyviz/assets/design-cards/violin-summary-hierarchy/good/panel.png and good-spec.json",
      "evidence": "Raw dots straddle/intersect the right KDE contours in groups A/B/C, prominently near upper B and central C. This is visible in both full PNG and 96 dpi preview. Adopted violin width .64 and lane offset .28 place the lane in the contour envelope.",
      "requirement": "A side lane and subordinate contour must remain distinguishable; the teaching card claims separation of KDE, quartiles and observations.",
      "action": "Narrow the KDE body and/or move the lane outward with sufficient actual dot-to-contour clearance. Retain all values, 8 pt font, 66 x 68 mm canvas and point size; confirm lane remains associated with its category and fits before the next category. Inspect new full/96 dpi images.",
      "status": "open"
    },
    {
      "id": "DC-02",
      "severity": "minor",
      "location": "Design-card captions, especially violin-summary-hierarchy/caption.md, heatmap-tall-narrow/caption.md, scatter-small-mark-color/caption.md",
      "evidence": "Missing word/number spaces: and100, linear0–100, All68; distribution caption has Tukey1.5IQR.",
      "requirement": "Reusable teaching prose should be readable and accurate without formatting artifacts.",
      "action": "Use and 100; linear 0–100; All 68; Tukey 1.5 × IQR.",
      "status": "open"
    },
    {
      "id": "DC-03",
      "severity": "note",
      "location": "distribution-summary-lane and violin-summary-hierarchy good axes",
      "evidence": "Tick labels repeat unnecessary .0 at 8 pt on compact 66 mm cards. No clipping or value ambiguity is visible.",
      "requirement": "Compact figure text should retain useful precision without unnecessary ink.",
      "action": "Optional: use integer display labels at these exact tick values, retaining the adopted numeric scale.",
      "status": "residual_note"
    }
