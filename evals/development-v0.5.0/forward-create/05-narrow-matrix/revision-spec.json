      "myC14",
      "myC15",
      "myC02",
      "myC03",
      "myC04",
      "myC05",
      "myC06",
      "myC07",
      "myC08",
      "myC09"
    ],
    "x": [
      "Omental",
      "Perivascular",
      "Subcutaneous"
    ]
